# MongoDB Atlas connection string
ATLASDB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Session secret — use a long random string (e.g. openssl rand -hex 32)
SECRET=your_secret_key_here

# Cloudinary credentials — from cloudinary.com dashboard
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# Optional — defaults to 8080 if not set
# PORT=8080
